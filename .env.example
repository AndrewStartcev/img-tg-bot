# Telegram
TELEGRAM_BOT_TOKEN=
ACCESS_PREFIX=1234

# Дополнительная защита. Необязательно.
# Укажи свой Telegram user_id, например:
# ALLOWED_USER_IDS=123456789
# Несколько ID: 123456789,987654321
ALLOWED_USER_IDS=

# Qwen Image 2.1
# 4-bit Diffusers-сборка: transformer + text encoder в FP4, VAE в BF16.
QWEN_MODEL_ID=Qwen/Qwen-Image-2.1
HF_TOKEN=

# Генерация
GENERATE_WIDTH=1024
GENERATE_HEIGHT=1024
EDIT_MAX_SIDE=1024
INFERENCE_STEPS=30
TRUE_CFG_SCALE=1.0

# Telegram
SEND_AS_DOCUMENT=true
SILENT_AUTH_FAILURE=true
MAX_PROMPT_LENGTH=4000

# Кэш весов. install.sh создаст каталог.
HF_HOME=/opt/img-tg-bot-hf-cache

# Если true, модель начнёт грузиться сразу после запуска бота.
# Иначе она загрузится при первом запросе или команде "1234 /warmup".
MODEL_LOAD_ON_START=false


# Hugging Face network
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
DIFFUSERS_OFFLINE=0
HF_HUB_DISABLE_XET=1
HF_HUB_ETAG_TIMEOUT=60
HF_HUB_DOWNLOAD_TIMEOUT=300
